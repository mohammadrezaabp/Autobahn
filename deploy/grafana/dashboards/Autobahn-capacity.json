    {
      "id": 12,
      "type": "timeseries",
      "title": "In flight and queued",
      "description": "Requests being forwarded per model, and requests waiting for a slot. A queue that does not empty means the backend, or Gateway:Resilience:MaxConcurrentForwardsPerModel, is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
