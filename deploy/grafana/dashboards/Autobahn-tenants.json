    {
      "id": 6,
      "type": "timeseries",
      "title": "Share of each model by key",
      "description": "A key above 0.5 of a model while another tenant is refused is what GatewayNoisyNeighbour fires on.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
