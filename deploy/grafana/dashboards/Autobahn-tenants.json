          },
          "refId": "A",
          "expr": "sum by (model, tenant, key) (rate(gateway_inference_requests_total{tenant=~\"$tenant\",key=~\"$key\",model=~\"$model\"}[$__rate_interval])) / on(model) group_left() sum by (model) (rate(gateway_inference_requests_total{model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{model}}: {{tenant}} / {{key}}"
        }
      ]
