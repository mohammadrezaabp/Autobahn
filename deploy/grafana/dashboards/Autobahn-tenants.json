    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests / s by tenant",
      "description": "Inference requests the gateway started or refused at admission. Requests a rate limit refused are not in it; see Refusals.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (tenant) (rate(gateway_inference_requests_total{tenant=~\"$tenant\",key=~\"$key\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 3,
